# Copy to your shell profile and fill in; never commit real values.
export GITHUB_PAT="$(gh auth token)"
export AWS_PROFILE="<your-sso-profile>"
export AWS_REGION="<region>"
export GRAFANA_URL="https://<your-grafana-host>"
export GRAFANA_SERVICE_ACCOUNT_TOKEN="<viewer-service-account-token>"
export SONARQUBE_URL="https://<your-sonarqube-host>"
export SONARQUBE_TOKEN="<sonarqube-user-token>"
export TEMPO_API_TOKEN="<tempo-token>"   # friday-logwork only
